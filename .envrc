# ROCm Environment Configuration
# This file can be used with direnv or sourced manually

# ROCm GPU Architecture (RX 7700 XT is gfx1100, RDNA 3)
export HSA_OVERRIDE_GFX_VERSION=11.0.0
export PYTORCH_ROCM_ARCH=gfx1100

# ROCm paths
export ROCm_HOME=/opt/rocm
export ROCM_VERSION=6.0

# PyTorch backend
export TORCH_BACKEND=rocm
export HIP_VISIBLE_DEVICES=0

# Performance optimizations
export PYTORCH_HIP_ALLOC_CONF=expandable_segments:True

# Library paths (if ROCm is installed system-wide)
if [ -d "/opt/rocm" ]; then
    export LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:${LD_LIBRARY_PATH:-}
    export PATH=/opt/rocm/bin:${PATH}
fi
